formulas:
  Poid: 30 + 3 * note.CON + note.level * 10
  PV: 8 + 4 * note.level + (formula["+CON"] * note.level *1.5).ceil()
  Tours: (formula["cases ABS"]/6).floor()
  cases: formula["cases ABS"]%6
  +CON: (note.CON/6).floor()
  +FOR: (note.FOR/6).floor()
  +INT: (note.INT/6).floor()
  +VIT: (note.VIT/6).floor()
  +VOL: (note.VOL/6).floor()
  +CTRL: (note.CTRL/6).floor()
  cases ABS: (1 + note.VIT/3).floor()
properties:
  formula.Tours:
    displayName: tours
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "monstres"
        - file.ext == "md"
    order:
      - file.name
      - level
      - CON
      - CTRL
      - FOR
      - INT
      - VIT
      - VOL
      - formula.+CON
      - formula.+CTRL
      - formula.+FOR
      - formula.+INT
      - formula.+VIT
      - formula.+VOL
      - formula.PV
      - formula.cases
      - formula.Tours
      - formula.cases ABS
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 129
      note.level: 64
      note.CON: 71
      note.CTRL: 74
      note.FOR: 67
      note.INT: 58
      note.VIT: 66
      note.VOL: 70
      formula.Tours: 77
