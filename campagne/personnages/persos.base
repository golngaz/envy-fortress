formulas:
  CON: note["bonus CON"] + note["classe"].asFile().properties["CON"]
  CTRL: note["bonus CTRL"] + note["classe"].asFile().properties["CTRL"]
  FOR: note["bonus FOR"] + note["classe"].asFile().properties["FOR"]
  INT: note["bonus INT"] + note["classe"].asFile().properties["INT"]
  VIT: note["bonus VIT"] + note["classe"].asFile().properties["VIT"]
  VOL: note["bonus VOL"] + note["classe"].asFile().properties["VOL"]
  Poid: 30 + 3 * formula.CON + note.level * 10
  PV: 8 + 4 * note.level + (formula["+CON"] * note.level *1.5).ceil()
  Tours: (formula["cases ABS"]/6).floor()
  cases: formula["cases ABS"]%6
  +CON: (formula.CON/6).floor() - 1
  cases ABS: (1 + formula.VIT/3).floor()
  +FOR: (formula.FOR/6).floor() - 1
  +INT: (formula.INT/6).floor() - 1
  +VIT: (formula.VIT/6).floor() - 1
  +VOL: (formula.VOL/6).floor() - 1
  +CTRL: (formula.CTRL/6).floor() - 1
properties:
  formula.Tours:
    displayName: tours
  formula.Poid:
    displayName: Poids
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "campagne/personnages"
        - file.ext == "md"
    order:
      - file.name
      - level
      - classe
      - formula.CON
      - formula.+CON
      - formula.CTRL
      - formula.+CTRL
      - formula.FOR
      - formula.+FOR
      - formula.INT
      - formula.+INT
      - formula.VIT
      - formula.+VIT
      - formula.VOL
      - formula.+VOL
      - formula.PV
      - formula.cases
      - formula.Tours
      - formula.Poid
      - formula.cases ABS
    sort:
      - property: formula.+VIT
        direction: DESC
      - property: formula.CTRL
        direction: DESC
    columnSize:
      note.level: 64
      formula.Tours: 77
